# Lab image: strongSwan built from the master branch, because ML-DSA
# signature authentication is not in the 6.1.0 release yet. Lab only:
# unreleased code must not be deployed to production gateways.
FROM debian:trixie-slim
ARG SS_REF=master
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config libssl-dev curl ca-certificates git \
      autoconf automake libtool gettext bison flex gperf python3 \
      iproute2 iputils-ping openssl tcpdump procps \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${SS_REF} https://github.com/strongswan/strongswan.git /usr/src/strongswan \
    && cd /usr/src/strongswan && git rev-parse HEAD > /etc/strongswan-commit \
    && ./autogen.sh >/dev/null 2>&1 \
    && ./configure --prefix=/usr --sysconfdir=/etc --enable-openssl --enable-ml \
         --disable-gmp --enable-silent-rules >/dev/null \
    && make -j"$(nproc)" >/dev/null && make install >/dev/null \
    && rm -rf /usr/src/strongswan
