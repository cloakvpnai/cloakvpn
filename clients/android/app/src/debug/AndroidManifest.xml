<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: the CNSA 2.0 lab mode (TLS 1.3 tunnel).
    Nothing here is part of the release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <application>
        <activity
            android:name=".cnsa2.Cnsa2LabActivity"
            android:exported="true"
            android:label="Lattice CNSA 2.0 lab" />
        <service
            android:name=".cnsa2.LatticeTlsVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
