<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Company>KryptoKnightz LLC</Company>
    <Product>Lattice VPN</Product>
    <Copyright>Copyright (c) KryptoKnightz LLC</Copyright>
    <Version>2.0.0</Version>

    <!-- lattice_tls.dll and wintun.dll for the architecture being built.
         x64 unless publishing with -r win-arm64. -->
    <LatticeNativeArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</LatticeNativeArch>
    <LatticeNativeArch Condition="'$(LatticeNativeArch)' == ''">x64</LatticeNativeArch>
    <LatticeNativeDir>$(MSBuildThisFileDirectory)native\out\$(LatticeNativeArch)\</LatticeNativeDir>
  </PropertyGroup>

</Project>
