# Secrets — never commit
*.key
*.rosenpass-secret
*.p12
*.mobileprovision

# iOS build-time secrets (CLOAK_BOOTSTRAP_KEY, etc). Wired into the
# Xcode project as baseConfigurationReference. The .example template
# IS committed so contributors know the format; the real file is not.
clients/ios/CloakVPN/Secrets.xcconfig
!clients/ios/CloakVPN/Secrets.xcconfig.example

# Peer configuration files — contain real WireGuard private keys + rosenpass
# secret keys generated by server/scripts/add-peer.sh. Pattern catches both
# `_peer-config.txt` (full PQC config, ~1.4 MB) and `_peer-config-wg-only.txt`
# (classical fallback). Leading underscore is the working convention so a
# `git status` always surfaces these as untracked rather than tracked.
_peer-config*.txt
_peer-config*.ini
**/iphone-prod-*.config.ini
**/iphone-prod-*.config.txt

# Xcode per-user state (iOS + macOS clients) — never belongs in git
xcuserdata/
*.xcuserstate
clients/ios/*.xcodeproj/xcuserdata/
clients/ios/*.xcworkspace/xcuserdata/
clients/ios/DerivedData/
clients/ios/build/
clients/ios/.swiftpm/

# Android
clients/android/.gradle/
clients/android/build/
clients/android/app/build/
clients/android/local.properties
clients/android/.idea/
clients/android/*.iml
clients/android/captures/

# Rust / Rosenpass build artifacts
target/
*.so
!app/src/main/jniLibs/**/*.so

# macOS / editor cruft
.DS_Store
*.swp
.vscode/
.idea/

# Wrangler (Cloudflare Pages deploy CLI — local cache only)
.wrangler/

# Go — compiled binaries (cross-built for deploy; see docs/DEPLOY_API.md
# and docs/DEPLOY_MULTIREGION.md). The source is committed, the artifacts
# are not.
/server/api/cloakvpn-api
/server/api/regionsvc

# Node (for future build steps)
node_modules/

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Editor / tooling backups. Timestamped .bak-* files are produced when a
# config or source file is edited in place (e.g. project.pbxproj version
# bumps); the real history lives in git, so they are never committed.
*.bak
*.bak-*

# Scratch build logs written next to the Xcode project.
build_cowork.log

# One-off experiment scratch dirs (e.g. the 2026-09 iOS deployment-target
# trial). Kept on disk for reference, out of the repo.
clients/ios/_deployment-target-experiment-*/

# Local build / diagnostic output (2026-10-08 cleanup): Android build logs,
# saved output of scripts/diag-*.sh (fleet details), and locally built server
# binaries. The scripts themselves are tracked; their output is not.
clients/android/*.log
scripts/*.out
server/api/dist/
_to_delete/
server/cloak-rpd/.work/
server/cloak-rpd/build.log
